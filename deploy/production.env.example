# Docker Compose paths and loopback ports.
# Keep both repositories as siblings, or set this to an absolute path.
KOVAR_ADMIN_WEBSIDE_CONTEXT=../kovar-agent-admin-webside
ADMIN_WEB_HOST_PORT=3000
GATEWAY_HOST_PORT=8080

# PostgreSQL. Generate once with: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_HEX

# Gateway upstreams. Production mode requires HTTPS upstream URLs.
KOVAR_BASE_URL=https://kovar.ai
KOVAR_MANAGE_BASE_URL=
KOVAR_MODEL_BASE_URL=
KOVAR_HTTP_TIMEOUT=120s
REQUEST_TIMEOUT=130s

# Gateway authentication and encryption.
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
# Generate once with: openssl rand -base64 32
# Never rotate this value without migrating the encrypted database fields.
ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
ADMIN_TOKEN_TTL=8h
AGENT_NONCE_TTL=5m
AGENT_SIGNATURE_MAX_CLOCK_SKEW=5m

# Gateway budgets and limits. Confirm these values against your business policy.
DEFAULT_PER_REQUEST_LIMIT=10000
DEFAULT_DAILY_LIMIT=100000
DEFAULT_MONTHLY_LIMIT=1000000
RATE_LIMIT=120
RATE_LIMIT_IP=300
RATE_LIMIT_ADMIN_LOGIN=10
MAX_BODY_BYTES=8388608
LOG_LEVEL=INFO

# Admin Webside server-to-Gateway request timeout in milliseconds.
# Keep this greater than REQUEST_TIMEOUT.
GATEWAY_TIMEOUT_MS=135000
# Normally leave empty because the supplied Nginx config preserves the public Host.
# If another proxy rewrites Host, provide comma-separated public host[:port] values.
ALLOWED_ORIGINS=
